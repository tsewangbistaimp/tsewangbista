NEXT_PUBLIC_SITE_URL=https://your-vercel-domain.vercel.app

# Formspree endpoint for the Order Inquiry form.
# Create a free form at https://formspree.io (recipient: contact@tsewangbista.com)
# and paste the endpoint it gives you, e.g. https://formspree.io/f/abcdwxyz
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/REPLACE_WITH_YOUR_FORM_ID

# ---------------------------------------------------------------------------
# Private research questionnaire (/q/<QUESTIONNAIRE_SLUG>) - see QUESTIONNAIRE.md
# ---------------------------------------------------------------------------
QUESTIONNAIRE_ENABLED=false
# Random secret path piece, 16+ characters. Generate: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
QUESTIONNAIRE_SLUG=
# Optional closing date (ISO), e.g. 2026-12-31T23:59:00+05:45
QUESTIONNAIRE_CLOSES_AT=
# token = personal invite links (needs Supabase) | code = shared access code | none = secret link only
QUESTIONNAIRE_ACCESS=token
QUESTIONNAIRE_ACCESS_CODE=
# Long random string used to sign cookies
QUESTIONNAIRE_SESSION_SECRET=
# Password for /q/<slug>/admin
QUESTIONNAIRE_ADMIN_PASSWORD=
# Email (Resend)
RECIPIENT_EMAIL=tsewangbistaimp@gmail.com
RESEND_API_KEY=
MAIL_FROM=Questionnaire Website <onboarding@resend.dev>
# Backup store (Supabase) - run supabase.sql first
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: personalised advice at the end (falls back to fixed tips if empty)
ANTHROPIC_API_KEY=
